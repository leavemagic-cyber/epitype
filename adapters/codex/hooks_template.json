{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_EXECUTABLE}} {{EPITYPE_HOOKS_ROOT}}/sessionstart.py",
            "timeout": 10,
            "additionalContextLimit": 1800
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_EXECUTABLE}} {{EPITYPE_HOOKS_ROOT}}/recall.py",
            "timeout": 10,
            "additionalContextLimit": 1800
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_EXECUTABLE}} {{EPITYPE_HOOKS_ROOT}}/precompact.py --codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_EXECUTABLE}} {{EPITYPE_HOOKS_ROOT}}/pretooluse.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_EXECUTABLE}} {{EPITYPE_HOOKS_ROOT}}/stop.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_EXECUTABLE}} {{EPITYPE_HOOKS_ROOT}}/stop.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
