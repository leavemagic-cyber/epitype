{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{EPITYPE_HOOKS_ROOT}}/sessionstart.py\"",
            "timeout": 3,
            "additionalContextLimit": 1800
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{EPITYPE_HOOKS_ROOT}}/recall.py\"",
            "timeout": 3,
            "additionalContextLimit": 1800
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{EPITYPE_HOOKS_ROOT}}/precompact.py\" --codex",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{EPITYPE_HOOKS_ROOT}}/pretooluse.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
